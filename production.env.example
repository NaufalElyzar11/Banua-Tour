# Template; replace placeholders on the deployment server. Never commit real secrets.
CI_ENVIRONMENT = production
app.baseURL = 'https://YOUR_DOMAIN/'
app.indexPage = ''
database.default.hostname = 127.0.0.1
database.default.database = banuatour
database.default.username = YOUR_APP_DB_USER
database.default.password = 'YOUR_APP_DB_PASSWORD'
database.default.DBDriver = MySQLi
database.default.DBDebug = false
database.default.port = 3306
# Linux example. For Windows, specify the absolute mysqldump.exe path.
MYSQLDUMP_PATH = '/usr/bin/mysqldump'
